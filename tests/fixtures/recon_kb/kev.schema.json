{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "catalogVersion",
    "vulnerabilities"
  ],
  "properties": {
    "catalogVersion": {
      "type": "string"
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cveID",
          "vendorProject",
          "product",
          "vulnerabilityName",
          "dateAdded",
          "shortDescription"
        ],
        "properties": {
          "cveID": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
          },
          "dateAdded": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
